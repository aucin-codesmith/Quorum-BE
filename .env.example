# Copy to .env and adjust. Used by `npm run dev` and read by docker compose for variable substitution.

NODE_ENV=development
PORT=3000

# --- Database ---------------------------------------------------------------
# Docker Compose starts PostgreSQL and publishes it on DB_PORT (default 5433) so you can also run
# the API from your machine with `npm run dev`.
POSTGRES_USER=quorum
POSTGRES_PASSWORD=quorum_dev_password
POSTGRES_DB=quorum
DB_PORT=5433
DATABASE_URL=postgres://quorum:quorum_dev_password@localhost:5433/quorum

# --- Auth -------------------------------------------------------------------
# REQUIRED in production: a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10
# Max login/register attempts per IP per 15 minutes. Use ~10-20 in production.
AUTH_RATE_LIMIT=100
# Number of reverse proxies in front of the API (0 = none) so rate limiting sees the real client IP.
TRUST_PROXY=0

# --- CORS -------------------------------------------------------------------
# Comma-separated front-end origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173,http://localhost:5199

# --- Business rules ---------------------------------------------------------
APP_TIMEZONE=Asia/Jakarta
WORK_START=08:00
WORK_END=18:00

# --- Demo data --------------------------------------------------------------
# docker compose seeds demo users, rooms and reservations on first start.
SEED_ON_START=true
SEED_PASSWORD=Password123!
